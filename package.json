{
  "name": "@lioncao/wiki-web",
  "version": "0.3.0",
  "description": "Self-hosted web UI for your Markdown wiki vault: browse, BM25 search, link graph, lint dashboard. No Obsidian, no database. Standalone, or pair with dsh agent plugins.",
  "license": "MIT",
  "type": "module",
  "main": "server.js",
  "bin": {
    "wiki-web": "server.js"
  },
  "scripts": {
    "start": "node server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "obsidian",
    "wiki",
    "knowledge-base",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lion-1209/dsh-wiki-web.git"
  },
  "dependencies": {
    "d3-dispatch": "^3.0.1",
    "d3-force": "^3.0.0",
    "d3-quadtree": "^3.0.1",
    "d3-timer": "^3.0.1",
    "dsh-plugin-wiki-tools": "^0.14.2",
    "marked": "^12.0.0"
  }
}
